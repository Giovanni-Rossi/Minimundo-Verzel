# Banco de dados. Padrão: SQLite num arquivo local.
DATABASE_URL=sqlite:///./biblioteca.db
# Para usar o Postgres do time de banco, cole o link que eles passaram (nunca versione o .env):
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# true: a API cria as tabelas e semeia leitores (use com o SQLite local).
# false: usa as tabelas do time de banco sem alterar nada (use com o Postgres deles).
CRIAR_TABELAS=true

# Origens liberadas no CORS, separadas por vírgula. 5173 é a porta padrão do Vite (web/).
CORS_ORIGINS=http://localhost:5173
